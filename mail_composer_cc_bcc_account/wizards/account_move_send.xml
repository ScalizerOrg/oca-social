<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="account_move_send_form_inherit" model="ir.ui.view">
        <field name="name">account.move.send.wizard.form.inherit</field>
        <field name="model">account.move.send.wizard</field>
        <!--
            [MIG v19]: the single-invoice sending wizard XML id changed from
            ``account.account_move_send_form`` (v17) to
            ``account.account_move_send_wizard_form`` (v19). The wizard model
            is now account.move.send.wizard and the mode field no longer
            exists (batch sending is a separate wizard).
        -->
        <field name="inherit_id" ref="account.account_move_send_wizard_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mail_partner_ids']/.." position="after">
                <field
                    name="partner_cc_ids"
                    widget="many2many_tags_email"
                    context="{'force_email':True, 'show_email':True}"
                />
                <field
                    name="partner_bcc_ids"
                    widget="many2many_tags_email"
                    context="{'force_email':True, 'show_email':True}"
                />
            </xpath>
        </field>
    </record>

</odoo>
